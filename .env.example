# NavixAI Environment Configuration

# Django Backend
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# Database Configuration (MySQL by default, falls back to SQLite if unreachable)
DB_ENGINE=sqlite
MYSQL_DATABASE=navixai_db
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Indoor Navigation Engine Configuration
WALKING_SPEED_MPS=1.2
COORDINATE_SCALE_METRES=1.0
VERTICAL_FLOOR_PENALTY_METRES=15.0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000

# Google Maps JavaScript API (outdoor campus map).
# Leave empty to use the built-in CampusNav fallback map (no key required).
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAP_ID=
