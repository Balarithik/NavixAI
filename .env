# NavixAI Environment Configuration

# Django Backend
DJANGO_SECRET_KEY=navixai-local-7c9f4e1a2d8b6f0e3c5a9d7b1f4e6c8a0d2f5b7e9c1a3d6f8b0e2c4a6d8f1
