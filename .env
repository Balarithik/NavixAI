# NavixAI Environment Configuration

# Django Backend
DJANGO_SECRET_KEY=navixai-insecure-dev-key-change-in-production-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,https://navixai.onrender.com,https://navixai-backend.onrender.com

# Database Configuration (Defaults to sqlite for out-of-the-box local testing, switch to mysql when ready)
DB_ENGINE=sqlite
MYSQL_DATABASE=navixai_db
MYSQL_USER=root
MYSQL_PASSWORD=MYSQL_PASSWORD
MYSQL_HOST=localhost
MYSQL_PORT=3306

# Indoor Navigation Engine Configuration
WALKING_SPEED_MPS=1.2
COORDINATE_SCALE_METRES=1.0
VERTICAL_FLOOR_PENALTY_METRES=15.0

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000,https://navixai.onrender.com,https://navixai-backend.onrender.com
